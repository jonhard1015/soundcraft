<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.wabty.studio</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>WABTY Studio</name>
  <summary>Record, edit and mix audio and MIDI</summary>
  <developer id="com.wabty">
    <name>WABTY</name>
  </developer>
  <description>
    <p>
      WABTY Studio is an open-source, native digital audio workstation. Record, edit and mix
      multitrack audio and MIDI in Edit and Mix windows that work the way studio engineers expect.
    </p>
    <ul>
      <li>Non-destructive clip editing with fades, playlists, grids and markers</li>
      <li>A mixer with inserts, sends, buses, automation and metering</li>
      <li>Built-in EQ, dynamics, reverb, delay, modulation and instruments</li>
      <li>Imports WAV, AIFF, FLAC, MP3 and MIDI; bounces to disk</li>
      <li>A headless command line and an MCP server for scripting and agents</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.wabty.studio.desktop</launchable>
  <icon type="stock">com.wabty.studio</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
  </categories>
  <keywords>
    <keyword>daw</keyword>
    <keyword>audio</keyword>
    <keyword>mixer</keyword>
    <keyword>recording</keyword>
    <keyword>midi</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#8fd9e6</color>
    <color type="primary" scheme_preference="dark">#0b7385</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>soundcraft</binary>
    <mediatype>application/x-soundcraft-session</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
